# Server Configuration
HOST=0.0.0.0
PORT=8000
DEBUG=false

# CORS Configuration (comma-separated list of allowed origins, or * for all)
CORS_ORIGINS=*

# Session and Storage Configuration
# Default: System temporary directory / pdf_editor_sessions
# STORAGE_DIR=/tmp/pdf_editor_sessions
SESSION_TTL_MINUTES=120

# Upload Security: Max file upload size in bytes (default: 100MB)
MAX_UPLOAD_SIZE_BYTES=104857600

# OCR Tesseract Model Directory (default: ./tessdata)
# TESSDATA_PREFIX=./tessdata
